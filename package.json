{
  "name": "bravia-remote-card",
  "version": "0.1.0",
  "description": "Home Assistant dashboard card: a remote control for Sony BRAVIA TVs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/bravia-remote-card.ts --bundle --minify --format=esm --target=es2021 --loader:.svg=text --legal-comments=none --outfile=dist/bravia-remote-card.js --define:__VERSION__=\\\"0.1.0\\\"",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
